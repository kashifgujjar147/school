# =============================================================================
# School Management System — per-school environment file
# Copy to server/.env (one file PER SCHOOL INSTALLATION). Never commit real values.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
# cloud  = Atlas only | local = local MongoDB only (no internet) | hybrid = local MongoDB + Atlas sync
APP_MODE=cloud
HOST=0.0.0.0
PORT=8080
# Public URL of this installation (used for cookies, CORS, SMS status callbacks)
APP_URL=https://attendance.school-a.example
# Extra allowed browser origins (comma separated). LAN example: http://192.168.1.10:8080
CORS_ORIGINS=
# Set true only when served over HTTPS (cloud). Leave false for plain-HTTP LAN installs.
COOKIE_SECURE=true
TRUST_PROXY=1

# --- Identity of this installation -------------------------------------------
# A unique id for this school; written into the database on first start and verified on every
# start so this app can never be pointed at another school's database by mistake.
SCHOOL_INSTALL_ID=school-a-2026
# Unique id of THIS server node (e.g. "school-a-local-1", "school-a-cloud"). Used by sync.
NODE_ID=school-a-cloud

# --- Package -----------------------------------------------------------------
# starter | standard   (enforced by backend; not editable from the dashboard)
PACKAGE=standard

# --- Database ----------------------------------------------------------------
# cloud mode: the school's own Atlas URI. local/hybrid: the local MongoDB URI.
MONGODB_URI=mongodb+srv://school_a_app:CHANGE_ME@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=school_a
# hybrid only: the school's Atlas database used as sync target
ATLAS_SYNC_URI=
ATLAS_SYNC_DB_NAME=
SYNC_INTERVAL_SECONDS=60

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=CHANGE_ME_64_HEX
# Encrypts SMS provider credentials stored in the database (32 bytes hex = 64 chars)
DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# --- Login controls ----------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Public "Create account" on the sign-in page. New accounts are PENDING with no role and cannot
# sign in until an administrator approves them (Users page -> Approve account). Set false to disable.
REGISTRATION_ENABLED=true
# One-time first-administrator web setup at /setup (no PowerShell needed). Only works while the
# database has NO active principal/admin. On an empty database the server also creates the school
# records at start. Use a long random value (16+ chars), then remove it after setup. Empty = disabled.
SETUP_TOKEN=

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
LOG_LEVEL=info

# --- Website media (Website Management → Media library) ---------------------
# Optional. With all three set, uploads go straight from the browser to Cloudinary using a
# server-generated signature (the secret never reaches the browser). Without them, uploads are
# stored on this server under UPLOAD_DIR/website. Pasted Cloudinary URLs work either way.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside the Cloudinary account (default: school-<SCHOOL_INSTALL_ID>/website)
CLOUDINARY_FOLDER=
WEBSITE_IMAGE_MAX_MB=8
WEBSITE_VIDEO_MAX_MB=100

# --- SMS (Standard package) --------------------------------------------------
# none | twilio | http
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Generic HTTP gateway (many local gateways). Body template placeholders: {{to}} {{message}} {{from}}
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_HEADERS={"Content-Type":"application/json"}
SMS_HTTP_BODY={"to":"{{to}}","message":"{{message}}","sender":"{{from}}"}
SMS_HTTP_FROM=
# JSON path in the gateway response containing the message id (e.g. data.id)
SMS_HTTP_ID_PATH=id
# Shared secret the gateway must send as ?token= on delivery-receipt callbacks
SMS_WEBHOOK_TOKEN=

# --- First-run principal (used only by `npm run init:school`) ----------------
INIT_PRINCIPAL_USERNAME=principal
INIT_PRINCIPAL_NAME=School Principal
# Leave blank to have a strong random password generated and printed once
INIT_PRINCIPAL_PASSWORD=
INIT_SCHOOL_NAME=School A
INIT_TIMEZONE=Asia/Karachi

# --- WhatsApp Business Cloud API (v1.2, Standard package, optional) ------------
# Can also be entered in Notifications -> WhatsApp (stored encrypted). Leave blank to disable.
# Alerts the school starts must use a template APPROVED by Meta with ONE body variable ({{1}}).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App secret: verifies X-Hub-Signature-256 on status callbacks (POST /api/webhooks/whatsapp)
WHATSAPP_APP_SECRET=
# Verify token you enter in the Meta webhook settings (GET /api/webhooks/whatsapp handshake)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0

# --- Online fee payments (v1.2, optional) -------------------------------------
# none | stripe. Can also be entered in Fees -> Fee settings (stored encrypted).
# Payments are recorded ONLY after Stripe's signed webhook is verified AND the checkout session is
# re-confirmed through Stripe's API. Webhook URL: <APP_URL>/api/webhooks/payments/stripe
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Must match the school's fee currency (Fees -> Fee settings), lower-case ISO code
PAYMENT_CURRENCY=pkr
